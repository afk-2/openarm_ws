# Cup perception stages (cup_perception/cup_pose_estimator).
Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Value: true
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 0.1
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Description Source: Topic
    Visual Enabled: true
    Description Topic:
      Value: /robot_description
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: D435 raw cloud
    Enabled: false
    Value: false
    Topic:
      Value: /camera/camera/depth/color/points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Color Transformer: RGB8
    Style: Points
    Size (Pixels): 1
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 1 cropped (grey)
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/cropped
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 160; 160; 160
    Style: Points
    Size (Pixels): 2
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 2 above table (yellow)
    Enabled: false
    Value: false
    Topic:
      Value: /cup_perception/above_table
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 255; 210; 0
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: '3 removed: on the robot (red)'
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/robot_points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 255; 40; 40
    Style: Points
    Size (Pixels): 4
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 4 objects (yellow)
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/objects
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 255; 210; 0
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 5 cup clusters (green)
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/cup_clusters
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 0; 220; 0
    Style: Points
    Size (Pixels): 4
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 6 outer wall fit points (cyan)
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/outer_wall
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 0; 230; 255
    Style: Points
    Size (Pixels): 6
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/PointCloud2
    Name: 7 handle points (magenta)
    Enabled: true
    Value: true
    Topic:
      Value: /cup_perception/handle_points
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Transformer: FlatColor
    Color: 255; 0; 255
    Style: Points
    Size (Pixels): 7
    Decay Time: 0
    Queue Size: 10
  - Class: rviz_default_plugins/MarkerArray
    Name: 8 cup estimates (markers)
    Enabled: true
    Value: true
    Namespaces:
      cup: true
      handle: true
      label: true
    Topic:
      Value: /cup_perception/markers
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PoseArray
    Name: 9 all cup poses (axes)
    Enabled: false
    Value: false
    Shape: Axes
    Axes Length: 0.05
    Axes Radius: 0.003
    Topic:
      Value: /cup_poses_estimate
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Pose
    Name: 10 target cup pose (/cup_pose_estimate)
    Enabled: true
    Value: true
    Shape: Axes
    Axes Length: 0.06
    Axes Radius: 0.004
    Topic:
      Value: /cup_pose_estimate
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 1.0
      Focal Point:
        X: 0.4
        Y: -0.15
        Z: 0.35
      Pitch: 0.7
      Yaw: 3.4
      Value: Orbit (rviz)
Window Geometry:
  Height: 900
  Width: 1400
